# Database (Neon Serverless Postgres)
# Pooled connection string (host with -pooler) used at runtime by Next.js app via @neondatabase/serverless and db:check
DATABASE_URL_POOLED="postgresql://<role>:<password>@<ep-pooler-host>.neon.tech/<database>?sslmode=require"

# Direct / non-pooled connection string used for migrations and schema DDL
DATABASE_URL="postgresql://<role>:<password>@<ep-host>.neon.tech/<database>?sslmode=require"

# Authentication (NextAuth v5)
# Random 32-byte secret (generate with: npx auth secret, or openssl rand -base64 32)
AUTH_SECRET="your_generated_32_byte_secret_here"

# Authentication base URL (http://localhost:3000 locally, or https://chavantraders.store in production)
AUTH_URL="http://localhost:3000"

# Optional: Public site URL (defaults to https://chavantraders.store)
NEXT_PUBLIC_SITE_URL="https://chavantraders.store"
